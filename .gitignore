# Dependencies
node_modules/
npm-debug.log
yarn-error.log

# Environment
.env
.env.local
.env.development
.env.test
.env.production

# Build output
client/dist/
server/logs/
build/

# Database files (CRITICAL: Do NOT track SQLite databases in Git to prevent overwriting production data)
*.sqlite
*.sqlite3
*.db
server/data/*.sqlite
server/data/*.sqlite3
# Uploaded asset media and documents (Do NOT track dynamic upload files in Git)
server/uploads/*
!server/uploads/images/
!server/uploads/documents/
server/uploads/images/*
!server/uploads/images/.gitkeep
server/uploads/documents/*
!server/uploads/documents/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

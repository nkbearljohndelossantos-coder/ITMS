<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NKB Backup Agent" Language="1033" Version="1.0.0.0" Manufacturer="NKB Manufacturing Corp." UpgradeCode="78b8f2c3-9d1a-4e2b-8a5c-6e7f8a9b0c1d" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NKB Backup Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="NKB Backup Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NKB Backup Agent" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentServiceExecutable" Bitness="always64" Guid="a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d">
        <File Id="ServiceExe" Source="..\publish\win-x64\Nkb.Backup.Agent.Service.exe" KeyPath="yes" />
        <ServiceInstall
          Id="ServiceInstaller"
          Type="ownProcess"
          Name="NKBBackupAgent"
          DisplayName="NKB Backup Agent"
          Description="Enterprise Backup &amp; Recovery Agent for NKB IT Management System"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Vital="yes" />
        <ServiceControl Id="StartService" Start="install" Stop="both" Remove="uninstall" Name="NKBBackupAgent" Wait="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>

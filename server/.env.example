# NKB Manufacturing Centralized API Platform Environment Variables

# Node.js Server Environment
NODE_ENV=production
PORT=5000

# Security & API Key Cryptography
API_KEY_PEPPER=nkb_secret_pepper_random_64_bit_string_change_in_production
JWT_SECRET=super_secret_jwt_access_key_change_in_production_2026
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nkb_api_user
DB_PASSWORD=SecurePassword123!
DB_NAME=nkb_api_platform
DATABASE_URL=postgresql://nkb_api_user:SecurePassword123!@127.0.0.1:5432/nkb_api_platform

# CORS Approved Frontend Origins (Comma-separated)
CORS_ORIGIN=https://nkbmanufacturing.com,https://dcc.nkbmanufacturing.com,https://ppe.nkbmanufacturing.com,http://localhost:3000,http://localhost:5173

# Rate Limiting Defaults
DEFAULT_RATE_LIMIT_PER_MIN=100
DEFAULT_RATE_LIMIT_PER_HOUR=1000

# Server API Domain
API_DOMAIN=https://api.nkbmanufacturing.com
